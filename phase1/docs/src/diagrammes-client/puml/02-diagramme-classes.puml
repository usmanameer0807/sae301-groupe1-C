@startuml DiagrammeClassesClient
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam classFontSize 13
skinparam classAttributeFontSize 12
skinparam nodesep 60
skinparam ranksep 60
skinparam linetype ortho

title Diagramme de classes - Client JavaFX

class LoginController {
    - champPseudo : TextField
    - boutonConnexion : Button
    --
    + seConnecter() : void
    + afficherErreur(msg : String) : void
}

class MainController {
    - listeUtilisateurs : ListView
    - listeBattles : ListView
    --
    + rafraichirContexte() : void
    + seDeconnecter() : void
}

class CardsController {
    - listeCartes : ListView
    --
    + recommander() : void
    + repudier() : void
    + revendiquerCarte() : void
    + authentifierCarte() : void
    + demanderLegitimation() : void
}

class CreateCardController {
    - champNom : TextField
    - champAnnee : TextField
    - listeDomaine : ComboBox
    - zoneDescription : TextArea
    --
    + creerCarte() : void
    + validerFormulaire() : boolean
}

class BattlesController {
    - barreProgression : ProgressBar
    --
    + lancerBattle() : void
    + voter() : void
    + demarrerChrono() : void
}

class ProfileController {
    --
    + afficherMesCartes() : void
    + afficherRecommandationsRecues() : void
}

class SceneManager {
    --
    + changerScene(nomFichier : String) : void
}

class ServerConnection {
    - socket : Socket
    - lecteur : BufferedReader
    - ecrivain : BufferedWriter
    --
    + connecter(hote : String, port : int) : void
    + envoyer(requete : String) : void
    + fermer() : void
}

class MessageReader {
    - threadLecture : Thread
    --
    + demarrer() : void
    + arreter() : void
}

class RequestService {
    --
    + envoyerRequete(type : String, donnees : String) : void
}

class ResponseHandler {
    --
    + traiterReponse(json : String) : void
}

class ClientState {
    - utilisateur : User
    - cartes : List<Card>
    - recommandees : List<String>
    - recommandationsRecues : List<RecommandationRecue>
    - battles : List<Battle>
    - utilisateurs : List<User>
    --
    + mettreAJour() : void
    + reinitialiser() : void
}

class User {
    - id : String
    - pseudo : String
    - estLegitime : boolean
    - estBot : boolean
    - nbRecommandationsValides : int
}

class Card {
    - id : String
    - nom : String
    - createurHistorique : String
    - anneeCreation : int
    - domaine : String
    - description : String
    - proprietaireId : String
    - createurId : String
    - valeur : int
    - statut : String
    - estAuthentifiee : boolean
    - authentifieePar : String
    - dateAuthentification : String
    - winCount : int
    - createdAt : String
}

class Battle {
    - id : String
    - carteAId : String
    - carteBId : String
    - domaine : String
    - statut : String
    - dureeSecondes : int
    - votesA : int
    - votesB : int
    - gagnanteId : String
}

class RecommandationRecue {
    - idCarte : String
    - idUtilisateur : String
}

class JsonUtil {
    --
    + versJson(objet : Object) : String
    + depuisJson(json : String, classe : Class) : Object
}

LoginController --> SceneManager
MainController --> SceneManager
CardsController --> SceneManager
CreateCardController --> SceneManager
BattlesController --> SceneManager
ProfileController --> SceneManager

LoginController --> RequestService
MainController --> RequestService
CardsController --> RequestService
CreateCardController --> RequestService
BattlesController --> RequestService
ProfileController --> RequestService

RequestService --> ServerConnection
ServerConnection --> MessageReader
MessageReader --> ResponseHandler
ResponseHandler --> ClientState
ResponseHandler --> SceneManager

ServerConnection --> JsonUtil
RequestService --> JsonUtil

ClientState "1" *-- "0..*" Card
ClientState "1" *-- "0..*" Battle
ClientState "1" *-- "0..*" User
ClientState "1" *-- "0..*" RecommandationRecue

@enduml
